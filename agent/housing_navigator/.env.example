# Copy to agent/housing_navigator/.env (git-ignored) for `adk web` / `adk run`.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-qwiklabs-project-id
GOOGLE_CLOUD_LOCATION=us-central1

A4I_DATASET=a4i_housing
A4I_LOCATION=US
A4I_METRO=San Francisco
A4I_STATE_CODE=CA
A4I_EMBED_CONNECTION=
A4I_EMBED_ENDPOINT=text-embedding-005
A4I_COMPLAINTS_EMBEDDED=complaint_embeddings
GEMINI_MODEL=gemini-2.5-flash

# Google-managed BigQuery MCP server (enable once: gcloud beta services mcp enable bigquery.googleapis.com)
ENABLE_BQ_MCP=true
