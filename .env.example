# Optional overrides for scripts/load.sh and notebooks/
# Copy to .env (git-ignored) only if using a custom Cloud Storage snapshot bucket or dataset.

# Cloud Storage bucket hosting pre-staged snapshots (leave unset to load from repo data/*.parquet)
A4I_SNAPSHOT_BUCKET=
A4I_SNAPSHOT_PREFIX=a4i-2026/challenge-housing

# Target BigQuery dataset and location in your team's GCP project
A4I_DATASET=a4i_housing
A4I_LOCATION=US

# Per-command timeout in seconds for gcloud / bq CLI calls
A4I_CMD_TIMEOUT_SEC=180

# --- Agent / API (agent/, api/) ---
# Gemini through Vertex AI in the lab project (no API key needed; uses gcloud application-default login)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-3b4b41069fc3
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery objects the tools read
# Must match the model that built the *_embedded tables (gemini-embedding-2, 3072 dims,
# via the us.a4i-vertex connection; see sql/0*_embed_*.sql).
A4I_EMBED_ENDPOINT=gemini-embedding-2
A4I_EMBED_CONNECTION=us.a4i-vertex
A4I_MODEL=gemini-2.5-flash
